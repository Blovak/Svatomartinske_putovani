rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pouze pro samostatný projekt této aplikace. Veřejný klient nepřistupuje přímo.
    // Apps Script REST používá OAuth/IAM a musí mít odpovídající oprávnění.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
